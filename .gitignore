# Models & weights (multi-GB — never commit)
# 루트 한정(/models/) — app/models/ 소스 패키지는 추적해야 한다.
/models/
*.safetensors
*.gguf
!app/models/

# Eval data & generated hypotheses (re-downloadable / re-generatable)
data/

# Python / uv
.venv/
__pycache__/
*.pyc
.python-version

# Logs (all logs live under logs/ to keep the root clean)
logs/
*.log

# Env
.env

# 디자인 핸드오프(참조 덤프 — 사용 에셋은 web/public에 복사됨)
design-handoff/
