# ── 공개 API 인증 ────────────────────────────────────────────────
# 키는 DB(api_keys 테이블)에서 관리한다(발급·폐기·감사). 아래 두 키는 '부트스트랩'용:
#  · API_KEYS: 시작 시 DB에 insert-if-absent 로 seed(콘솔/FE 키가 항상 유효하도록). 쉼표구분.
#              DB에 활성 키가 하나도 없으면 인증 비활성(개발/데모).
#  · ADMIN_API_KEY: 키 관리 Admin API(/api/v1/api-keys, X-Admin-Key)를 보호. 비우면 Admin 비활성.
# 외부 기업 키는 Admin API로 런타임 발급/폐기한다(.env에 나열하지 않는다).
API_KEYS=lt_console_gwP_9Jf302unUgOUsoaO8lIrK2snUvu9
ADMIN_API_KEY=adm_CHANGE_ME_generate_with_secrets_token_urlsafe

# 콘솔(FE)이 빌드 시 baked 해서 쓰는 키 — 위 API_KEYS(콘솔용)와 일치시킬 것.
# ⚠️ 브라우저 번들에 노출되므로 콘솔 전용 키를 쓰고, 외부 기업엔 Admin API로 별도 발급.
VITE_API_KEY=lt_console_gwP_9Jf302unUgOUsoaO8lIrK2snUvu9

# ── 실행 프로파일 ────────────────────────────────────────────────
# vLLM/aligner 는 gpu/cpu 프로파일로 묶여 있어 `docker compose up`(프로파일 없음)이면
# 안 뜬다. `./run.sh`(GPU 자동감지)를 쓰거나, 아래를 설정하면 bare `docker compose up`도
# gpu 프로파일을 포함한다. (CPU 배포는 `cpu`)
COMPOSE_PROFILES=gpu

# ── Quality LLM (교체 가능) ──────────────────────────────────────
# 최종 LLM. HF repo id(hf-cache 자동 다운로드) 또는 로컬 경로(/models/…). draft(HY-MT)는 고정.
QUALITY_MODEL=Qwen/Qwen3.5-4B

# HuggingFace 토큰 — gated/private 모델 다운로드용. compose 가 컨테이너 HF_TOKEN 으로 매핑.
# HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# ── (참고) 프로필별 override, 보통 run.sh 가 자동 처리 ─────────────
# QUALITY_ENABLED=true
# DRAFT_URL=http://vllm-draft:8000/v1
# QUALITY_URL=http://vllm-quality:8000/v1
# ALIGN_URL=http://aligner:8000
